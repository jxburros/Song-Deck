// Felt Keys: an example sampled instrument for the Song Deck plugin API (spec §57).
// The samples are generated by make-samples.mjs (deterministic synthesis, no third-party audio).
<control>
default_path=samples/
<global>
ampeg_attack=0.003
ampeg_release=0.28
amp_veltrack=85
<region> sample=felt-c2.wav lokey=21 hikey=41 pitch_keycenter=36
<region> sample=felt-c3.wav lokey=42 hikey=53 pitch_keycenter=48
<region> sample=felt-c4.wav lokey=54 hikey=65 pitch_keycenter=60
<region> sample=felt-c5.wav lokey=66 hikey=108 pitch_keycenter=72
