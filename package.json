{
  "name": "song-deck",
  "version": "0.6.0",
  "private": true,
  "description": "Structured AI music workstation: AI composes, performs, and produces music without taking the composition away from you.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/audio",
    "packages/ai",
    "apps/studio",
    "apps/server"
  ],
  "scripts": {
    "dev": "npm run dev -w @songdeck/studio",
    "dev:server": "npm run dev -w @songdeck/server",
    "build": "npm run build -w @songdeck/studio",
    "start:server": "node scripts/runtime/start.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p packages/core && tsc -p packages/audio && tsc -p packages/ai && tsc -p apps/server && tsc -p apps/studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "npm run e2e -w @songdeck/studio",
    "docs:genres": "tsx scripts/gen-genres-doc.ts",
    "size": "npm run size -w @songdeck/studio",
    "release:check": "node scripts/release/check.mjs",
    "release:package": "node scripts/release/package.mjs",
    "release:smoke": "node scripts/release/smoke.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "4.1.11"
  }
}
